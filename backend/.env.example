# Project Settings
PROJECT_NAME=CreateFlowX
API_V1_STR=/api/v1

# Security Settings
# IMPORTANT: In production, generate a secure random key (e.g. openssl rand -hex 32)
SECRET_KEY=your_production_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local SQLite: sqlite:///./cfx.db
# Production PostgreSQL (on Render): postgres://user:password@host:port/dbname
DATABASE_URL=sqlite:///./cfx.db

# CORS Configuration
# In development: *
# In production: https://createflowx.vercel.app,http://localhost:5173
BACKEND_CORS_ORIGINS=*
